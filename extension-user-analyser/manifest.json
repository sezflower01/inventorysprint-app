{
  "manifest_version": 3,
  "name": "InventorySprint — User Analyser",
  "version": "0.1.0",
  "description": "Reads the Amazon product page you are already viewing and shows it alongside your own InventorySprint account. Uses no seller credentials.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://mstibdszibcheodvnprm.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/dp/*",
        "https://*.amazon.com/*/dp/*",
        "https://*.amazon.com/gp/product/*"
      ],
      "js": [
        "readPage.js",
        "panelCss.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://inventorysprint.com/*",
        "https://*.inventorysprint.com/*"
      ],
      "js": [
        "handoff.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
